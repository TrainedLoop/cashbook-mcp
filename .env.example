# Public HTTPS URL the server is reachable at (no trailing slash, no /mcp)
PUBLIC_URL=https://cashbook.owner.example.ts.net

# Comma-separated Google logins allowed to use the connector and /admin (the owner only)
ALLOWED_EMAILS=owner@example.com

# Optional (defaults shown)
# REFRESH_AT=06:00
# TZ=America/Sao_Paulo
# HISTORY_MONTHS=12
# LOG_LEVEL=INFO
# PORT=8743
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Only for examples/tailscale-sidecar/: the node's full tailnet name, used for its certificate
# TS_CERT_DOMAIN=cashbook.owner.example.ts.net
